# Говорим GitHub, что файлы .apk — это код на Kotlin
*.apk linguist-language=Kotlin
*.apk linguist-detectable=true

# Оставляем HTML как HTML
*.html linguist-language=HTML

# Игнорируем сам файл настроек и README, чтобы они не мешали балансу
.gitattributes linguist-vendored
README.md linguist-vendored
