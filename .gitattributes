# Тяжелый .apk файл маскируем под HTML (он даст проекту базу HTML)
*.apk linguist-language=HTML
*.apk linguist-detectable=true

# Магия: заставляем GitHub увидеть в одном файле index.html сразу три языка!
index.html linguist-language=Kotlin
index.html linguist-language=JavaScript
index.html linguist-language=CSS
index.html linguist-detectable=true

# Прячем служебные файлы, чтобы не ломали картину
.gitattributes linguist-vendored
README.md linguist-vendored
