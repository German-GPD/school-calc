# Тяжелый .apk файл маскируем под HTML
*.apk linguist-language=HTML
*.apk linguist-detectable=true

# Ваш .html файл маскируем под Kotlin
*.html linguist-language=Kotlin
*.html linguist-detectable=true

# Ваши реальные JS-файлы будут считаться как JavaScript
*.js linguist-language=JavaScript
*.js linguist-detectable=true

# Игнорируем служебные файлы и README
.gitattributes linguist-vendored
README.md linguist-vendored
