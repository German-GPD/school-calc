# Файлы .apk будут считаться за Kotlin
*.apk linguist-language=Kotlin
*.apk linguist-detectable=true

# Файл README.md принудительно делаем TypeScript
README.md linguist-language=TypeScript
README.md linguist-detectable=true

# Оставляем HTML как HTML
*.html linguist-language=HTML

# Прячем сам файл атрибутов, чтобы он не влиял на проценты
.gitattributes linguist-vendored
