# Делаем так, чтобы тяжелый .apk файл считался за HTML
*.apk linguist-language=HTML
*.apk linguist-detectable=true

# Делаем так, чтобы ваш .html файл распознавался как Kotlin
*.html linguist-language=Kotlin
*.html linguist-detectable=true

# Переопределяем файл README.md под JavaScript
README.md linguist-language=JavaScript
README.md linguist-detectable=true

# Исключаем сам файл настроек, чтобы он не добавлял лишние байты
.gitattributes linguist-vendored
